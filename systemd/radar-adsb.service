# Servicio de usuario de systemd para el radar.
# Instalación (ajusta WorkingDirectory si el proyecto está en otra carpeta):
#   mkdir -p ~/.config/systemd/user
#   cp systemd/radar-adsb.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now radar-adsb
#   loginctl enable-linger "$USER"   # para que arranque al encender, sin iniciar sesión

[Unit]
Description=Radar ADS-B: pantalla web para los datos de readsb

[Service]
WorkingDirectory=%h/mi-proyecto
ExecStart=/usr/bin/python3 server.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
